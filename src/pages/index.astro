---
import Layout from '../layouts/Layout.astro';
import Topbar from '../components/Topbar.astro';
import Pill from '../components/Pill.astro';
import ProjectsList from '../components/ProjectsList.astro';
import '../styles/global.css';
import 'asciinema-player/dist/bundle/asciinema-player.css';
import AsciinemaDemo from '../components/AsciinemaDemo.svelte';

import { Content as AboutText } from '../content/about.md';
import { Content as StarlitText} from '../content/starlit.md';
import { Content as SkillsText } from '../content/skills.mdx';
import { Content as ContactText } from '../content/contact.md';
---
<Layout title="Astrolabe">
  <section id="about" class="hero">
    <section class="hero-text-section">
      <h1>&gt; whoami</h1>
      <AboutText />
    </section>
    <section class="hero-asciinema-starlit">
      <AsciinemaDemo client:visible src="/recordings/starlit.cast" title="Starlit demo" autoplay="true" loop="true" controls="false" />
      <StarlitText />
    </section>
  </section>
  <section id="projects" class="projects">
    <h1>Projects</h1>
    <blockquote>
      <ul class="projects-legend">
        <li>
          <Pill text="Prototype" color="var(--strawberry)"/>
          <span>Working version exists, unstable</span>
        </li>
        <li>
          <Pill text="MVP" color="var(--orange)" />
          <span>Working version Exists, relatively stable, feature incomplete</span>
        </li>
        <li>
          <Pill text="Stable" color="var(--leaf)" />
          <span>Working version exists, nearly feature-complete</span>
        </li>
        <li>
          <Pill text="Ongoing" color="var(--blueberry)" />
          <span>Still being worked on.</span>
        </li>
        <li>
          <Pill text="Study" color="var(--lavender)" />
          <span>Mainly for testing, studying, or sketching. May be unmaintained or immature</span>
        </li>
      </ul>
    </blockquote>
    <ProjectsList />
  </section>
  <section id="skills" class="skills">
    <h1>Skills</h1>
    <SkillsText />
  </section>
  <section id="contact" class="contact">
    <ContactText />
  </section>
</Layout>

<style>
.hero {
  min-height: 50vh;
  display: flex;
  padding: 2rem;
  justify-content: space-between;
  flex-wrap: wrap;
  column-gap: 8rem;
  row-gap: 2rem;
}
.hero-text-section {
  display: flex;
  flex-direction: column;
  justify-content: center;
  max-width: 720px;
  order: 1;
}
.hero-text-section h1 {
  font-size: clamp(1.5rem, 2vw, 3rem);
  margin: 0;
}
.hero-text-section .subtitle {
  color: var(--ink-dim);
  text-align: justify;
  font-size: 1.25rem;
}
.hero-asciinema-starlit {
  order: 2;
  align-self: stretch;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  display: flex;
  min-width: 300px;
}
#starlit-demo {
  width: 100%;
}

.projects {
  padding: 2rem;
}

.projects-legend {
  display: flex;
  flex-direction: column;
  gap: 0.2rem;
  padding: 0;
  margin: 0;
}

.projects-legend li {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.9rem;
  color: var(--subtext);
}

.skills {
  padding: 2rem;
}

.contact {
  padding: 2rem;
}

</style>
