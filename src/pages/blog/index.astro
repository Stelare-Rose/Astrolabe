---
import { getCollection } from 'astro:content';
import BlogList from '../../components/BlogList.svelte';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publish.valueOf() - a.data.publish.valueOf())
  .map((p) => ({
    slug: p.id,
    title: p.data.title,
    description: p.data.description,
    publish: p.data.publish.toISOString(),
    tags: [...new Set([...p.data.topics, ...p.data.tags])],
  }));

// Auto-index: tag -> post count, most used first
const counts = new Map<string, number>();
for (const p of posts) for (const t of p.tags) counts.set(t, (counts.get(t) ?? 0) + 1);
const tagIndex = [...counts]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([name, count]) => ({ name, count }));
---
<Layout name="Astrolabe, The Blog">
  <main>
    <h1>Blog</h1>
    <BlogList client:load {posts} {tagIndex} />
  </main>
</Layout>


